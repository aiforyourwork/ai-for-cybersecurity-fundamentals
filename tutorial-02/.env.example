# Anthropic API key — get one at https://console.anthropic.com
# The analyst step uses Claude Haiku 4.5 by default (~$0.003 per run).
ANTHROPIC_API_KEY=

# Note on WebGoat session cookies: the JSESSIONID is NOT stored here. It
# expires every time WebGoat's Java process restarts (every `docker stop`/
# `docker start`, every host reboot), so storing it in .env causes silent
# stale-cookie bugs. Pass --cookie "JSESSIONID=<value>" on each run instead.
